{% macro color_field(field) %}
    <div class="mb-3">
        {{ form_label(field) }}
        <div class="input-group" data-controller="stripe-appearance-color-picker">
            <input type="color"
                   class="form-control form-control-color p-1"
                   style="width: 44px; flex: 0 0 44px; cursor: pointer"
                   tabindex="-1"
                   aria-hidden="true"
                   data-stripe-appearance-color-picker-target="picker"
                   data-action="input->stripe-appearance-color-picker#syncFromPicker">
            {{ form_widget(field, {attr: {
                placeholder: '#000000',
                'data-stripe-appearance-color-picker-target': 'text',
                'data-action': 'input->stripe-appearance-color-picker#syncFromText'
            }}) }}
            <button type="button"
                    class="btn btn-outline-secondary"
                    data-action="stripe-appearance-color-picker#clear"
                    title="Clear">
                &times;
            </button>
        </div>
        {{ form_errors(field) }}
    </div>
{% endmacro %}

{% import _self as macros %}

{% set appearance_form = hookable_metadata.context.form.gatewayConfig.config.stripe_appearance %}

<div class="card mb-3">
    <div class="card-header">
        <div class="card-title">
            {{ 'flux_se_sylius_stripe_plugin.stripe_appearance.title'|trans }}
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-info p-4 mb-4">
            <div class="d-flex align-items-start">
                <div class="me-2">{{ ux_icon('tabler:info-circle', {'class': 'icon alert-icon text-primary'}) }}</div>
                <div class="d-flex flex-wrap align-items-baseline gap-2">
                    <p class="mb-0 fw-bold">{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.info.core_variables'|trans }}</p>
                    <a href="https://docs.stripe.com/elements/appearance-api?api-integration=checkout&client=html#commonly-used-variables"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="fw-bold text-decoration-none">
                        {{ 'flux_se_sylius_stripe_plugin.stripe_appearance.info.open_stripe_docs'|trans }}
                    </a>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 mb-4 stripe-variables-toggle collapsed"
             role="button"
             data-bs-toggle="collapse"
             data-bs-target="#stripe-appearance-variables"
             aria-expanded="false"
             aria-controls="stripe-appearance-variables">
            <span class="fw-bold">{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.commonly_used_variables'|trans }}</span>
            {{ ux_icon('tabler:chevron-right', {'class': 'icon'}) }}
        </div>
        <div class="collapse mb-6" id="stripe-appearance-variables">
            <div class="col-12 col-xl-6 px-0">
            <table class="table table-bordered table-sm table-striped">
                <thead>
                    <tr>
                        <th>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.variable'|trans }}</th>
                        <th>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.description'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><code>fontFamily</code></td>
                        <td>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.font_family'|trans }}</td>
                    </tr>
                    <tr>
                        <td><code>fontSizeBase</code></td>
                        <td>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.font_size_base'|trans }}</td>
                    </tr>
                    <tr>
                        <td><code>spacingUnit</code></td>
                        <td>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.spacing_unit'|trans }}</td>
                    </tr>
                    <tr>
                        <td><code>borderRadius</code></td>
                        <td>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.border_radius'|trans }}</td>
                    </tr>
                    <tr>
                        <td><code>colorPrimary</code></td>
                        <td>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.color_primary'|trans }}</td>
                    </tr>
                    <tr>
                        <td><code>colorBackground</code></td>
                        <td>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.color_background'|trans }}</td>
                    </tr>
                    <tr>
                        <td><code>colorText</code></td>
                        <td>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.color_text'|trans }}</td>
                    </tr>
                    <tr>
                        <td><code>colorDanger</code></td>
                        <td>{{ 'flux_se_sylius_stripe_plugin.stripe_appearance.variables_table.color_danger'|trans }}</td>
                    </tr>
                </tbody>
            </table>
            </div>
        </div>
        <div class="row gx-5 gy-0">
            <div class="col-12 col-lg-4">
                {{ form_row(appearance_form.theme) }}
                {{ form_row(appearance_form.inputs) }}
                {{ form_row(appearance_form.labels) }}
            </div>
            <div class="col-12 col-lg-4">
                {{ macros.color_field(appearance_form.colorPrimary) }}
                {{ macros.color_field(appearance_form.colorBackground) }}
                {{ macros.color_field(appearance_form.colorText) }}
                {{ macros.color_field(appearance_form.colorDanger) }}
            </div>
            <div class="col-12 col-lg-4">
                {{ form_row(appearance_form.fontFamily) }}
                {{ form_row(appearance_form.borderRadius, {attr: {placeholder: '4px'}}) }}
                {{ form_row(appearance_form.spacingUnit, {attr: {placeholder: '4px'}}) }}
            </div>
        </div>
    </div>
</div>
