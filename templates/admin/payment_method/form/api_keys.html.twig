{% set publishable_key_form = hookable_metadata.context.form.gatewayConfig.config.publishable_key %}
{% set secret_key_form = hookable_metadata.context.form.gatewayConfig.config.secret_key %}
{% set secret_key_value = secret_key_form.vars.value|default('') %}

<div class="col-12 col-md-6">
    {{ form_row(publishable_key_form, sylius_test_form_attribute('config-publishable-key')) }}

    {% if sylius_stripe_is_legacy_secret_key(secret_key_value) %}
        <div class="mb-3" {{ sylius_test_html_attribute('config-secret-key') }}>
            <div class="d-flex align-items-center gap-2 mb-1">
                {{ form_label(secret_key_form, null, {'label_attr': {'class': 'form-label required mb-0'}}) }}
                <button type="button" class="stripe-legacy-row-badge btn btn-sm fw-bold p-2 rounded-3">
                    {{ 'flux_se_sylius_stripe_plugin.form.gateway_configuration.stripe.action.replace_key_badge'|trans }}
                </button>
            </div>
            {{ form_widget(secret_key_form) }}
            {{ form_errors(secret_key_form) }}
        </div>
    {% else %}
        {{ form_row(secret_key_form, sylius_test_form_attribute('config-secret-key')) }}
    {% endif %}

    {% if sylius_stripe_is_legacy_secret_key(secret_key_value) %}
        <div class="alert alert-warning mt-2" {{ sylius_test_html_attribute('secret-key-legacy-warning') }}>
            <div class="d-flex align-items-start">
                <div class="me-2">{{ ux_icon('tabler:alert-triangle', {'class': 'icon alert-icon text-warning'}) }}</div>
                <div>
                    <p class="fw-bold">
                        {{ 'flux_se_sylius_stripe_plugin.form.gateway_configuration.stripe.info.secret_key_legacy_warning'|trans }}
                    </p>
                    <p class="mb-0">
                        <a class="fw-bold text-decoration-none" href="https://docs.sylius.com/stripe-plugin/getting-started/stripe-app-and-restricted-api-key" target="_blank" rel="noopener noreferrer">
                            {{ 'flux_se_sylius_stripe_plugin.form.gateway_configuration.stripe.action.learn_more_restricted_keys'|trans }}
                        </a>
                    </p>
                </div>
            </div>
        </div>
    {% endif %}
</div>
